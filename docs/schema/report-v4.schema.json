{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sun-sh902.github.io/FlowAssert/schema/report-v4.schema.json",
  "title": "FlowAssert report, schema_version 4",
  "description": "The JSON report of a check in which either side FlowAssert read from one worksheet of an .xlsx workbook. Every member of version 1, with inputs.source_workbook or inputs.destination_workbook (or both); inputs.source_sheet and inputs.destination_hubspot keep their version 2 and 3 meanings when present.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 4
    },
    "cohort_state": {
      "description": "The batch result. The exit status follows it: 0, 1, 3.",
      "enum": [
        "Verified",
        "Mismatch",
        "Unverified"
      ]
    },
    "claim": {
      "description": "The claim of a Verified result; null otherwise.",
      "type": [
        "string",
        "null"
      ]
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "expected_total": {
      "description": "The number of source records when the source population is known; null otherwise.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source_rows_observed": {
      "type": "integer",
      "minimum": 0
    },
    "source_population_known": {
      "type": "boolean"
    },
    "destination_coverage_sufficient": {
      "type": "boolean"
    },
    "destination_rows_without_key": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "description": "One record per source row, in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "destination_only": {
      "description": "Scope exact only.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/destinationOnlyRecord"
      }
    },
    "destination_only_counts": {
      "$ref": "#/$defs/counts"
    },
    "details": {
      "enum": [
        "problems",
        "all"
      ]
    },
    "premises": {
      "$ref": "#/$defs/premises"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "obligation": {
      "$ref": "#/$defs/obligation"
    },
    "evaluator": {
      "const": "v2-current-state-1"
    },
    "evaluated_at": {
      "$ref": "#/$defs/utcTime"
    },
    "limitations": {
      "const": "Files and completeness statements are not authenticated. Not assessed: whether a workflow ran, whether the source is true, whether a record existed by a past deadline."
    },
    "workflow_execution": {
      "const": "Not assessed"
    },
    "business_truth": {
      "const": "Not assessed"
    },
    "existed_by_deadline": {
      "const": "Not assessed"
    },
    "acquisition_authenticity": {
      "const": "not_authenticated"
    }
  },
  "required": [
    "schema_version",
    "cohort_state",
    "claim",
    "counts",
    "expected_total",
    "source_rows_observed",
    "source_population_known",
    "destination_coverage_sufficient",
    "destination_rows_without_key",
    "records",
    "details",
    "premises",
    "inputs",
    "obligation",
    "evaluator",
    "evaluated_at",
    "limitations",
    "workflow_execution",
    "business_truth",
    "existed_by_deadline",
    "acquisition_authenticity"
  ],
  "allOf": [
    {
      "description": "Only a Verified result carries the claim.",
      "if": {
        "properties": {
          "cohort_state": {
            "const": "Verified"
          }
        },
        "required": [
          "cohort_state"
        ]
      },
      "then": {
        "properties": {
          "claim": {
            "const": "At this evaluation, under the stated premises, the supplied destination rows satisfy the rules for the supplied source rows."
          }
        }
      },
      "else": {
        "properties": {
          "claim": {
            "type": "null"
          }
        }
      }
    },
    {
      "description": "expected_total is a number exactly when the source population is known.",
      "if": {
        "properties": {
          "source_population_known": {
            "const": true
          }
        },
        "required": [
          "source_population_known"
        ]
      },
      "then": {
        "properties": {
          "expected_total": {
            "type": "integer"
          }
        }
      },
      "else": {
        "properties": {
          "expected_total": {
            "type": "null"
          }
        }
      }
    },
    {
      "description": "Destination-only records are reported exactly when the scope is exact.",
      "if": {
        "properties": {
          "obligation": {
            "properties": {
              "scope": {
                "const": "exact"
              }
            },
            "required": [
              "scope"
            ]
          }
        },
        "required": [
          "obligation"
        ]
      },
      "then": {
        "required": [
          "destination_only",
          "destination_only_counts"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "destination_only"
              ]
            },
            {
              "required": [
                "destination_only_counts"
              ]
            }
          ]
        }
      }
    },
    {
      "description": "With details all, every record has its rule results; with problems, a Verified record has none.",
      "if": {
        "properties": {
          "details": {
            "const": "all"
          }
        },
        "required": [
          "details"
        ]
      },
      "then": {
        "properties": {
          "records": {
            "items": {
              "required": [
                "candidates",
                "rules"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "records": {
            "items": {
              "if": {
                "properties": {
                  "state": {
                    "const": "Verified"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "candidates"
                      ]
                    },
                    {
                      "required": [
                        "rules"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "counts": {
      "description": "The number of records in each state. Pending is always 0: this check has no waiting window.",
      "type": "object",
      "properties": {
        "Verified": {
          "type": "integer",
          "minimum": 0
        },
        "Mismatch": {
          "type": "integer",
          "minimum": 0
        },
        "Pending": {
          "const": 0
        },
        "Unverified": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "Verified",
        "Mismatch",
        "Pending",
        "Unverified"
      ],
      "additionalProperties": false
    },
    "ruleResult": {
      "description": "One rule's result for one record.",
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "reason": {
          "description": "Why, in words.",
          "type": "string"
        },
        "rule": {
          "description": "The field's comparison rule, when it is not exact.",
          "type": "string"
        },
        "expected": {
          "description": "The source value, when a value was compared.",
          "type": [
            "string",
            "null"
          ]
        },
        "actual": {
          "description": "The destination value, when a value was compared.",
          "type": [
            "string",
            "null"
          ]
        },
        "expected_normalized": {
          "description": "The source value as the rule compared it; null when there was nothing to compare.",
          "type": [
            "string",
            "null"
          ]
        },
        "actual_normalized": {
          "description": "The same for the destination value.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "dependentRequired": {
        "expected": [
          "actual"
        ],
        "actual": [
          "expected"
        ],
        "expected_normalized": [
          "actual_normalized",
          "rule"
        ],
        "actual_normalized": [
          "expected_normalized",
          "rule"
        ]
      }
    },
    "rules": {
      "description": "existence, uniqueness, and one field:COLUMN result per compared field, named after the source column.",
      "type": "object",
      "properties": {
        "existence": {
          "$ref": "#/$defs/ruleResult"
        },
        "uniqueness": {
          "$ref": "#/$defs/ruleResult"
        }
      },
      "required": [
        "existence",
        "uniqueness"
      ],
      "patternProperties": {
        "^field:": {
          "$ref": "#/$defs/ruleResult"
        }
      },
      "additionalProperties": false
    },
    "record": {
      "description": "One source row. With details problems a Verified record has only key, source_row and state.",
      "type": "object",
      "properties": {
        "key": {
          "description": "The source key; null when it is empty; [redacted] with --redact-values.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_row": {
          "description": "The row's position among the source data rows, from 0.",
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "Verified",
            "Mismatch",
            "Unverified"
          ]
        },
        "candidates": {
          "description": "The number of destination rows carrying this key.",
          "type": "integer",
          "minimum": 0
        },
        "rules": {
          "$ref": "#/$defs/rules"
        }
      },
      "required": [
        "key",
        "source_row",
        "state"
      ],
      "dependentRequired": {
        "candidates": [
          "rules"
        ],
        "rules": [
          "candidates"
        ]
      },
      "if": {
        "properties": {
          "state": {
            "enum": [
              "Mismatch",
              "Unverified"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "candidates",
          "rules"
        ]
      }
    },
    "destinationOnlyRecord": {
      "description": "Scope exact: one destination key that no source row has.",
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "destination_row": {
          "description": "The position of the first destination data row with this key, from 0.",
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "description": "The number of destination rows with this key.",
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "Mismatch",
            "Unverified"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "destination_row",
        "rows",
        "state",
        "reason"
      ]
    },
    "statement": {
      "description": "A completeness statement, or the permission for identical content.",
      "type": "object",
      "properties": {
        "stated": {
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      },
      "required": [
        "stated",
        "origin"
      ]
    },
    "statedCount": {
      "description": "A total the caller saw in the original system, the rows read, and whether they are equal.",
      "type": "object",
      "properties": {
        "stated": {
          "description": "The number stated, of any size, or null when none was.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "observed": {
          "description": "The data rows read on that side.",
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "description": "Whether stated equals observed; null when no count was stated.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      },
      "required": [
        "stated",
        "observed",
        "matched",
        "origin"
      ],
      "if": {
        "properties": {
          "stated": {
            "type": "null"
          }
        },
        "required": [
          "stated"
        ]
      },
      "then": {
        "properties": {
          "matched": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "matched": {
            "type": "boolean"
          }
        }
      }
    },
    "otherPremise": {
      "description": "A premise a later release may add: still a statement FlowAssert did not verify.",
      "type": "object",
      "properties": {
        "stated": {
          "type": [
            "boolean",
            "integer",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      },
      "required": [
        "stated",
        "origin"
      ]
    },
    "origin": {
      "description": "Where the statement came from: command-line option, browser form, JavaScript call or n8n Code node. A reader shows a value it does not know as it is.",
      "type": "string"
    },
    "premises": {
      "description": "Every premise stated or not stated at this run. FlowAssert verifies none of them.",
      "type": "object",
      "properties": {
        "source_complete": {
          "$ref": "#/$defs/statement"
        },
        "destination_complete": {
          "$ref": "#/$defs/statement"
        },
        "source_count": {
          "$ref": "#/$defs/statedCount"
        },
        "destination_count": {
          "$ref": "#/$defs/statedCount"
        },
        "allow_identical_content": {
          "allOf": [
            {
              "$ref": "#/$defs/statement"
            },
            {
              "properties": {
                "stated": {
                  "const": true
                }
              }
            }
          ]
        }
      },
      "required": [
        "source_complete",
        "destination_complete",
        "source_count",
        "destination_count"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/otherPremise"
      }
    },
    "pair": {
      "description": "[source column, destination column]",
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "obligation": {
      "description": "What was checked.",
      "type": "object",
      "properties": {
        "type": {
          "const": "current_state"
        },
        "key": {
          "$ref": "#/$defs/pair"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pair"
          },
          "minItems": 1
        },
        "comparison": {
          "description": "exact-string when every field is compared exactly; per-field-rule when any field has another rule.",
          "enum": [
            "exact-string",
            "per-field-rule"
          ]
        },
        "rules": {
          "description": "One rule per field, in order: exact, trim, casefold, digits or date:FORMAT. Present when a configuration gave the rules.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(exact|trim|casefold|digits)$|^date:."
          }
        },
        "scope": {
          "enum": [
            "source",
            "exact"
          ]
        }
      },
      "required": [
        "type",
        "key",
        "fields",
        "comparison"
      ]
    },
    "utcTime": {
      "description": "UTC, ISO 8601, with microseconds only when they are not 0.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"
    },
    "sha256": {
      "description": "A SHA-256 digest in lower-case hex.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "description": "The digest of each side: a file's bytes, or the canonical form of a worksheet's, a sheet's or HubSpot's rows; and how each was read. At least one side was read from a workbook.",
      "type": "object",
      "properties": {
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "destination_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_complete_stated": {
          "type": "boolean"
        },
        "destination_complete_stated": {
          "type": "boolean"
        },
        "identical_content": {
          "description": "Whether the two digests are equal.",
          "type": "boolean"
        },
        "identical_content_allowed": {
          "const": true
        },
        "mapping_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "config_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_encoding": {
          "enum": [
            "utf-8",
            "utf-16",
            "gb18030"
          ]
        },
        "destination_encoding": {
          "enum": [
            "utf-8",
            "utf-16",
            "gb18030"
          ]
        },
        "source_sheet": {
          "$ref": "#/$defs/sourceSheet"
        },
        "destination_hubspot": {
          "$ref": "#/$defs/destinationHubspot"
        },
        "source_workbook": {
          "$ref": "#/$defs/sourceWorkbook"
        },
        "destination_workbook": {
          "$ref": "#/$defs/destinationWorkbook"
        }
      },
      "required": [
        "source_sha256",
        "destination_sha256",
        "source_complete_stated",
        "destination_complete_stated",
        "identical_content"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "identical_content": {
                "const": true
              }
            },
            "required": [
              "identical_content"
            ]
          },
          "then": {
            "required": [
              "identical_content_allowed"
            ]
          }
        },
        {
          "description": "At least one side was read from a workbook.",
          "anyOf": [
            {
              "required": [
                "source_workbook"
              ]
            },
            {
              "required": [
                "destination_workbook"
              ]
            }
          ]
        },
        {
          "description": "A source workbook, sheet or HubSpot listing has no encoding.",
          "if": {
            "anyOf": [
              {
                "required": [
                  "source_workbook"
                ]
              },
              {
                "required": [
                  "source_sheet"
                ]
              }
            ]
          },
          "then": {
            "not": {
              "required": [
                "source_encoding"
              ]
            }
          }
        },
        {
          "description": "The source is read one way only.",
          "not": {
            "required": [
              "source_workbook",
              "source_sheet"
            ]
          }
        },
        {
          "description": "A destination workbook, sheet or HubSpot listing has no encoding.",
          "if": {
            "anyOf": [
              {
                "required": [
                  "destination_workbook"
                ]
              },
              {
                "required": [
                  "destination_hubspot"
                ]
              }
            ]
          },
          "then": {
            "not": {
              "required": [
                "destination_encoding"
              ]
            }
          }
        },
        {
          "description": "The destination is read one way only.",
          "not": {
            "required": [
              "destination_workbook",
              "destination_hubspot"
            ]
          }
        }
      ]
    },
    "sourceSheet": {
      "description": "Where FlowAssert read the source rows: one range of a Google Sheets spreadsheet, read-only.",
      "type": "object",
      "properties": {
        "read_by": {
          "const": "FlowAssert"
        },
        "service": {
          "const": "Google Sheets API v4"
        },
        "spreadsheet_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,200}$"
        },
        "range_requested": {
          "type": "string"
        },
        "range_returned": {
          "type": "string"
        },
        "value_render_option": {
          "const": "FORMATTED_VALUE"
        },
        "date_time_render_option": {
          "const": "FORMATTED_STRING"
        },
        "major_dimension": {
          "const": "ROWS"
        },
        "read_at": {
          "$ref": "#/$defs/utcTime"
        },
        "revision": {
          "description": "The Drive revision just before and just after the values were read, which are equal; or why the read cannot be tied to a revision.",
          "oneOf": [
            {
              "description": "The revision was read both times.",
              "type": "object",
              "properties": {
                "available": {
                  "const": true
                },
                "before": {
                  "description": "Google Drive's version and modification time at one moment.",
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string",
                      "pattern": "^[0-9]{1,20}$"
                    },
                    "modified_time": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "version",
                    "modified_time"
                  ]
                },
                "after": {
                  "description": "Google Drive's version and modification time at one moment.",
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string",
                      "pattern": "^[0-9]{1,20}$"
                    },
                    "modified_time": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "version",
                    "modified_time"
                  ]
                }
              },
              "required": [
                "available",
                "before",
                "after"
              ]
            },
            {
              "description": "The read cannot be tied to a revision.",
              "type": "object",
              "properties": {
                "available": {
                  "const": false
                },
                "reason": {
                  "enum": [
                    "not requested (--skip-source-revision)",
                    "Google Drive returned no version"
                  ]
                }
              },
              "required": [
                "available",
                "reason"
              ]
            }
          ]
        },
        "canonical_form": {
          "const": "flowassert-sheet-csv-1"
        }
      },
      "required": [
        "read_by",
        "service",
        "spreadsheet_id",
        "range_requested",
        "range_returned",
        "value_render_option",
        "date_time_render_option",
        "major_dimension",
        "read_at",
        "revision",
        "canonical_form"
      ]
    },
    "destinationHubspot": {
      "description": "Where FlowAssert read the destination rows: the contacts HubSpot listed to the token, read-only.",
      "type": "object",
      "properties": {
        "read_by": {
          "const": "FlowAssert"
        },
        "service": {
          "const": "HubSpot CRM API v3"
        },
        "object": {
          "const": "contacts"
        },
        "properties": {
          "description": "The property names requested, in order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,100}$"
          }
        },
        "archived_excluded": {
          "const": true
        },
        "page_limit": {
          "const": 100
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "read_at": {
          "$ref": "#/$defs/utcTime"
        },
        "read_finished_at": {
          "$ref": "#/$defs/utcTime"
        },
        "canonical_form": {
          "const": "flowassert-hubspot-csv-1"
        }
      },
      "required": [
        "read_by",
        "service",
