   "invalid": [
    {
     "records": [
      {
       "key": "a"
      },
      {}
     ]
    },
    {
     "records": [
      {
       "key": 1
      }
     ]
    },
    {
     "records": {}
    }
   ]
  }
 ],
 "unsupported": [
