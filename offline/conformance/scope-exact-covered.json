{
  "name": "scope-exact-covered",
  "description": "With scope exact and sufficient destination coverage, a destination key that is not in the source is a destination-only Mismatch, so the cohort is a Mismatch while every source record is Verified.",
  "obligation": {
    "key": ["key", "key"],
    "fields": [["phone", "phone"]],
    "scope": "exact"
  },
  "source_rows": [
    {"key": "SYN-001", "phone": "+1 212 555 0101"},
    {"key": "SYN-002", "phone": "+1 212 555 0102"}
  ],
  "destination_rows": [
    {"key": "SYN-001", "phone": "+1 212 555 0101"},
    {"key": "SYN-002", "phone": "+1 212 555 0102"},
    {"key": "SYN-099", "phone": "+1 212 555 0199"}
  ],
  "premises": {
    "source_complete": true,
    "destination_complete": true
  },
  "expected": {
    "cohort_state": "Mismatch",
    "record_states": ["Verified", "Verified"],
    "expected_total": 2
  }
}
