{
  "name": "scope-exact-keyless-destination-row",
  "description": "With scope exact, a destination row without a key is never destination-only. It makes coverage insufficient, so the source records stay Unverified, but the source population is known, so the extra key is still a destination-only Mismatch.",
  "obligation": {
    "key": ["key", "key"],
    "fields": [["phone", "phone"]],
    "scope": "exact"
  },
  "source_rows": [
    {"key": "SYN-001", "phone": "+1 212 555 0101"},
    {"key": "SYN-002", "phone": "+1 212 555 0102"}
  ],
  "destination_rows": [
    {"key": "SYN-001", "phone": "+1 212 555 0101"},
    {"key": "SYN-002", "phone": "+1 212 555 0102"},
    {"key": "SYN-099", "phone": "+1 212 555 0199"},
    {"key": "", "phone": "+1 212 555 0100"}
  ],
  "premises": {
    "source_complete": true,
    "destination_complete": true
  },
  "expected": {
    "cohort_state": "Mismatch",
    "record_states": ["Unverified", "Unverified"],
    "expected_total": 2
  }
}
