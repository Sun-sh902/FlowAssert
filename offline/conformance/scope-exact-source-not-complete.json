{
  "name": "scope-exact-source-not-complete",
  "description": "With scope exact but without source_complete, a destination key that is not in the supplied source could belong to a source row that was not supplied, so it is listed without a conclusion and does not change the cohort state.",
  "obligation": {
    "key": ["key", "key"],
    "fields": [["phone", "phone"]],
    "scope": "exact"
  },
  "source_rows": [
    {"key": "SYN-001", "phone": "+1 212 555 0101"},
    {"key": "SYN-002", "phone": "+1 212 555 0102"}
  ],
  "destination_rows": [
    {"key": "SYN-001", "phone": "+1 212 555 0101"},
    {"key": "SYN-002", "phone": "+1 212 555 0102"},
    {"key": "SYN-099", "phone": "+1 212 555 0199"}
  ],
  "premises": {
    "source_complete": false,
    "destination_complete": true
  },
  "expected": {
    "cohort_state": "Unverified",
    "record_states": ["Verified", "Verified"],
    "expected_total": null
  }
}
