{
  "name": "scope-exact-not-covered",
  "description": "With scope exact, a destination-only row needs no destination premise: without destination_complete the source records stay Unverified, but the source population is known, so the extra key makes the cohort a Mismatch.",
  "obligation": {
    "key": ["key", "key"],
    "fields": [["phone", "phone"]],
    "scope": "exact"
  },
  "source_rows": [
    {"key": "SYN-001", "phone": "+1 212 555 0101"},
    {"key": "SYN-002", "phone": "+1 212 555 0102"}
  ],
  "destination_rows": [
    {"key": "SYN-001", "phone": "+1 212 555 0101"},
    {"key": "SYN-002", "phone": "+1 212 555 0102"},
    {"key": "SYN-099", "phone": "+1 212 555 0199"}
  ],
  "premises": {
    "source_complete": true,
    "destination_complete": false
  },
  "expected": {
    "cohort_state": "Mismatch",
    "record_states": ["Unverified", "Unverified"],
    "expected_total": 2
  }
}
